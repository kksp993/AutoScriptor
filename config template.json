{
    "app": {
        "app_to_start": "org.yjmobile.zmxy",
        "auto_start": true,
        "max_retry": 2,
        "name": "ZmxyOL",
        "restart_on_error": true,
        "run_in_background": false,
        "debug_mode": true,
        "cpu_cores": 4
    },
    "ocr": {
        "use_gpu": false
    },
    "emulator": {
        "index": 1,
        "adb_addr": "YOUR_ADB_ADDR, e.g.127.0.0.1:16416",
        "mumu_folder": "YOUR_MUMU_FOLDER, e.g.C:/Program Files/Netease/MuMu",
        "emu_path": "YOUR_EMU_PATH, e.g.C:/Program Files/Netease/MuMu/nx_main/MuMuManager.exe",
        "adb_path": "YOUR_ADB_PATH, e.g.C:/Program Files/Netease/MuMu/nx_main/adb.exe",
        "post_execution": "none"
    },
    "llm": {
        "use_agent": false,
        "url": "http://localhost:11434/v1",
        "model": "hf.co/bartowski/UI-TARS-2B-SFT-GGUF"
    },
    "deploy": {
        "log_level": "info",
        "theme": "dark",
        "password": null,
        "ssl_key": null,
        "ssl_cert": null,
        "language": "zh-CN",
        "cdn": false,
        "timezone_offset": null,
        "content_manifest_url": null,
        "content_manifest_sha256": null,
        "content_update_public_key_path": null,
        "content_update_public_key_pem": null,
        "content_update_require_credential_unlock": false,
        "content_update_apply_cooldown_sec": 180
    },
    "notify": {
        "enabled": false,
        "config_yaml": "provider: null"
    },
    "update": {
        "auto_check": true,
        "check_interval_minutes": 30,
        "auto_restart_time": null
    },
    "remote_access": {
        "enabled": false,
        "ssh_server": null,
        "ssh_user": null,
        "ssh_executable": "ssh"
    },
    "current_account": "default"
}
