# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
/.idea
/.vscode
**/__pycache__
**/build
**/dist
/MumuAdaptor.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
/.nuitka-cache

/release_snapshots/
# Nuitka 崩溃报告（本地排错）
nuitka-crash-report.xml
# Playwright / 调试截图（脚本目录）
/scripts/_pw*.png
**/.DS_Store
**/.venv
**/.env
**/.env.local
# Cursor：默认忽略插件/缓存，但跟踪协作用 rules（*.mdc）与项目 skill
/.cursor/*
!/.cursor/rules/
!/.cursor/rules/**
!/.cursor/skills/
!/.cursor/skills/**
# Agent 本机目录：共享规则放 docs/agents/，不要提交工具私有 skill/cache 目录
/.codex/
/.claude/
/.playwright-mcp/
# 忽略根目录下的 PNG 和 LOG 文件
/*.png
/*.log
/main.js

/output/
/activity_analysis/
/activity_lib/
/news/
/out/app/
/dist_plain_portable/
/dist_source_portable/
/packaging/
/errors/
/examples/
/logs/
/data/config.json
/data/accounts/*.json
# 配置与账号的原子写临时文件：.{文件名}.{随机}.tmp。正常路径会被 os.replace 消费，
# 进程在写入中途被终止时会残留；它们和 config.json 一样属于本机数据。
/data/.*.tmp
/data/accounts/.*.tmp
/data/canvas_data/
/data/logs/
/config.json
/config_*.json
/.python*
/.gitadd*
/docs/refs/
**/node_modules
frontend/electron/.release-staging
frontend/electron/buildResources/icon.ico
/accounts/
/custom_task/
/battle_character/
/.autoscriptor/
# 本地事故恢复/审计证据（可能含真实账号与凭据）：不提交
/_recovery/
docs/*.json
packaging_dllhost/
# 框架层发布验收的探针环境与运行数据（每次跑都会重建/覆盖）
/release_probe/.venv/
/release_probe/.runtime/
# 框架把运行日志写在进程的 cwd 下（logs/log/），探针的 cwd 就是自己的目录
/release_probe/logs/
